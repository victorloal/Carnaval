# Development environment for the Carnaval backend.
# Copy to `.env` (gitignored) at the repository root and fill in real values.
# Settings read only from environment variables and fail loudly when a
# required secret is absent (SEC-46 / NFR-09).

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Development switches. Unset means DEBUG off — production-like behaviour.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (ADR 0009). Leave DB_NAME empty to use the SQLite development
# fallback; production and CI set these to enable PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

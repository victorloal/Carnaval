# Development environment for the Carnaval backend.
# Copy to `.env` (gitignored) at the repository root and fill in real values.
# Settings read only from environment variables and fail loudly when a
# required secret is absent (SEC-46 / NFR-09).

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Development switches. Unset means DEBUG off — production-like behaviour.
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (ADR 0009). Leave DB_NAME empty to use the SQLite development
# fallback; production and CI set these to enable PostgreSQL.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Ingestion pipeline (FR-B). All optional; the defaults below are built in.
# The contact address is sent in every request's User-Agent (FR-B-14).
# INGESTION_CONTACT_EMAIL=victorloal513@gmail.com
# INGESTION_HTTP_TIMEOUT=30
# INGESTION_RETRY_BASE=5
# INGESTION_RETRY_ATTEMPTS=3
# INGESTION_RETRY_CAP=300
# INGESTION_BREAKER_THRESHOLD=5
# INGESTION_ROBOTS_CACHE_SECONDS=86400
# Raw payloads are gitignored; this is the swap point for object storage (ADR 0015).
# INGESTION_RAW_ROOT=./data/raw
# INGESTION_RAW_RETENTION_DAYS=30
# INGESTION_RAW_RETENTION_BYTES=50000000
# The edition the pipeline is populating. Unset, the newest existing edition is
# used; records outside that year fail the sanity gate.
# INGESTION_TARGET_YEAR=2027
